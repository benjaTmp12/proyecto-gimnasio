#  SERVIDOR BACKEND 
PORT=3000
NODE_ENV=development

#  BASE DE DATOS 
# Reemplaza con tus credenciales de MySQL locales
# En Railway esta variable se configura automáticamente en el panel
DATABASE_URL=mysql://usuario:password@localhost:3306/gimnasio_db

#  AUTENTICACIÓN JWT 
# Cambia esto por una cadena larga y segura (mínimo 32 caracteres)
# En producción configura esta variable en el panel de Railway
JWT_SECRET=cambia_esto_por_un_secreto_seguro_y_largo_aqui

#  CORS 
# URL del frontend local (Vite corre en 5173 por defecto)
# En producción: la URL pública de tu frontend en Vercel o Netlify
CORS_ORIGIN=http://localhost:5173

#  FRONTEND VITE 
# Las variables del frontend DEBEN empezar con VITE_
# Local: apunta al backend corriendo en tu máquina
VITE_API_URL=http://localhost:3000/api
# Producción: descomenta y reemplaza con la URL de Railway
# VITE_API_URL=https://tu-backend.up.railway.app/api
